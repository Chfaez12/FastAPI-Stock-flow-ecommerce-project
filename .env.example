PROJECT_NAME=StockFlow API

DATABASE_URL=postgresql://postgres.your-project-ref:yourpassword@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

SUPABASE_JWT_SECRET=your-supabase-jwt-secret
JWT_ALGORITHM=ES256

SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key

# Secret key (Supabase > Project Settings > API Keys > secret / service_role).
# Used only by the backend for product image uploads. Never put it in frontend/.env.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
PRODUCT_IMAGE_BUCKET=product-images

# Where the React app runs. Used for CORS and for the links in password-reset and
# verification emails (add <FRONTEND_URL>/** to Supabase > Authentication > URL Configuration).
FRONTEND_URL=http://localhost:5173

# Only read by docker-compose to build the frontend image.
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
